# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: booking | screener | mine
AGENT_PROFILE=mine
# Which models: budget | quality   (see src/models.py)
MODEL_PRESET=budget
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent

CARECALL_BACKEND=mock
CARECALL_PROFILE=config/patient.synthetic.json
CARECALL_RESULTS_DIR=results
# HTTP mode requires HTTPS API and optional CARECALL_API_TOKEN
# CARECALL_API_URL=https://your-backend.example

# Outbound requires a separate SIP provider; this does not make calling free.
CARECALL_OUTBOUND_ENABLED=false
SIP_OUTBOUND_TRUNK_ID=
SIP_FROM_NUMBER=
# Comma-separated international numbers explicitly authorized to receive calls.
CARECALL_ALLOWED_DESTINATIONS=

# Initial greeting language; recognition stays multilingual and can switch.
# auto starts in English, then follows the receptionist; en | ru | zh
CARECALL_LANGUAGE=auto
